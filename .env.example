# Database (async driver for the app)
POSTGRES_USER=tracegoblins
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tracegoblins
DATABASE_URL=postgresql+asyncpg://tracegoblins:change-me-please@db:5432/tracegoblins

# Secrets
# SECRET_KEY signs session cookies + CSRF tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-64-byte-urlsafe-token
# TOKEN_ENC_KEY: Fernet key for AWX token encryption (used from M4).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-with-fernet-key

# Cookies / sessions (behind TLS proxy COOKIE_SECURE=true)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
SESSION_REMEMBER_DAYS=30

# Reverse-proxy trust (CIDR uvicorn trusts for X-Forwarded-*). NEVER '*' in prod.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# App
ENVIRONMENT=production
APP_STATIC_DIR=/app/frontend/dist
