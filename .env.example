# Database (async driver for the app)
POSTGRES_USER=tracegoblins
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tracegoblins
DATABASE_URL=postgresql+asyncpg://tracegoblins:change-me-please@db:5432/tracegoblins

# Secrets
# SECRET_KEY signs session cookies + CSRF tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-64-byte-urlsafe-token
# TOKEN_ENC_KEY: Fernet key for AWX token encryption (used from M4).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-with-fernet-key

# Cookies / sessions (behind TLS proxy COOKIE_SECURE=true)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
SESSION_REMEMBER_DAYS=30
# Name of the session cookie.
#SESSION_COOKIE_NAME=tg_session
# How often (seconds) a session's last-seen timestamp is written back to the DB.
#TOUCH_THROTTLE_SECONDS=60

# Two-factor auth (TOTP)
# How long (minutes) a half-finished login (password OK, TOTP pending) stays valid.
#MFA_PENDING_TTL_MINUTES=5
# Force admins to enrol 2FA before using the app (redirect-to-enroll, non-bricking).
#MFA_ADMIN_REQUIRED=true

# Invites
# How long an admin-created invite link stays valid.
#INVITE_EXPIRE_HOURS=72

# Login rate limiting
# Lock an account/IP out for LOGIN_LOCKOUT_SECONDS after LOGIN_MAX_ATTEMPTS
# failed logins within LOGIN_WINDOW_SECONDS.
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_SECONDS=300
#LOGIN_LOCKOUT_SECONDS=900

# Security headers
# Send Content-Security-Policy-Report-Only instead of enforcing CSP (debugging only).
#CSP_REPORT_ONLY=false

# Background scheduler (AWX auto-sync + retention sweep). Disable only if you run
# a separate worker instance or never sync from AWX.
#SCHEDULER_ENABLED=true

# Retention
# ⚠ The nightly retention sweep PERMANENTLY DELETES AWX-synced runs (source='awx')
# older than RETENTION_DAYS — including their tasks, raw log, annotations, comments
# and shares. Age is the job's actual run time (falling back to import time).
# Uploaded/pasted runs are NEVER deleted. Default 90 days; set 0 to disable.
#RETENTION_DAYS=90

# Knowledge base
# pg_trgm similarity cutoff (0..1) for fuzzy KB matching; exact signature always wins.
#KB_MATCH_THRESHOLD=0.35

# Reverse-proxy trust (CIDR uvicorn trusts for X-Forwarded-*). NEVER '*' in prod.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# App
ENVIRONMENT=production
APP_STATIC_DIR=/app/frontend/dist
# Display name used in the UI/API.
#APP_NAME=Tracegoblins
